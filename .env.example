# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Copy this file to `.env` and fill in the real values. Never commit `.env`.
#
# Get both strings from: Supabase Dashboard → Project → Connect
#
# Both URLs need `uselibpqcompat=true&sslmode=require`. Without the compat flag,
# pg >= 8.22 treats plain `sslmode=require` as `verify-full` and rejects the
# Supabase pooler's certificate chain with "self-signed certificate in
# certificate chain". The flag restores libpq semantics: still encrypted, but
# without chain verification.
#
# Note the username is `postgres.[PROJECT-REF]`, not plain `postgres`, and the
# host is the pooler — NOT `db.[PROJECT-REF].supabase.co`. That direct host is
# IPv6-only, and Vercel's functions have no IPv6 egress, so it cannot be used
# at runtime.

# DATABASE_URL — used by the app at runtime (Vercel serverless functions).
# Use the "Transaction pooler" string (port 6543). The pooler is required
# because serverless functions open many short-lived connections.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require"

# DIRECT_URL — used only for schema changes (`prisma db push`) and seeding.
# Use the "Session pooler" string (port 5432). The transaction pooler on 6543
# cannot run DDL statements, so migrations need this separate connection.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"

# ─── Public URL ──────────────────────────────────────────────────────────────
# Base URL used to build tracking links (https://your-domain.com/t/<code>).
# Optional: when unset, the URL is derived from the incoming request, which is
# correct on Vercel and on preview deployments. Set it to pin a custom domain
# so links stay stable no matter which host served the request.
NEXT_PUBLIC_APP_URL="https://ads20.vercel.app"

# ─── Timezone ────────────────────────────────────────────────────────────────
# IANA timezone used for "today" and date filters in Admin → Conversions.
# Timestamps are always stored in UTC. Defaults to Asia/Kolkata.
APP_TIMEZONE="Asia/Kolkata"

# ─── JWT secrets ─────────────────────────────────────────────────────────────
# Each portal signs tokens with its own secret. Use long random strings
# (32+ chars). Generate with: openssl rand -base64 32
# REQUIRED in production: without them every login fails (the dev fallbacks
# are public in this repo and are never accepted in production).
JWT_SECRET_ADMIN=""
JWT_SECRET_PUBLISHER=""
JWT_SECRET_TRAFFIC=""
