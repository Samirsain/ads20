# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Copy this file to `.env` and fill in the real values. Never commit `.env`.
#
# Get both strings from: Supabase Dashboard → Project → Connect
#
# DATABASE_URL — used by the app at runtime (Vercel serverless functions).
# Use the "Transaction pooler" string (port 6543). The pooler is required
# because serverless functions open many short-lived connections.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL — used only for schema changes (`prisma db push`) and seeding.
# Use the "Session pooler" string (port 5432). The transaction pooler on 6543
# cannot run DDL statements, so migrations need this separate connection.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── JWT secrets ─────────────────────────────────────────────────────────────
# Each portal signs tokens with its own secret. Use long random strings
# (32+ chars). Generate with: openssl rand -base64 32
JWT_SECRET_ADMIN=""
JWT_SECRET_PUBLISHER=""
JWT_SECRET_TRAFFIC=""
