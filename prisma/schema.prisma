generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Publisher {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String
  name            String
  phone           String?
  // Available settled balance eligible to withdraw (excludes today's unsettled earnings and reserved funds).
  walletBalance   Decimal         @default(0) @db.Decimal(12, 4)
  // Funds reserved in active withdrawal requests (PENDING / APPROVED / PROCESSING / UNCERTAIN).
  reservedBalance Decimal         @default(0) @db.Decimal(12, 4)
  isActive        Boolean         @default(true)
  trackingLinks   TrackingLink[]
  conversions     Conversion[]
  withdrawals     PubWithdrawal[]
  clickEvents     Click[]
  createdAt       DateTime        @default(now())
}

model TrackingLink {
  id          String       @id @default(cuid())
  publisherId String
  publisher   Publisher    @relation(fields: [publisherId], references: [id])
  uniqueCode  String       @unique
  targetUrl   String
  linkType    String       @default("direct")
  clicks      Int          @default(0)
  conversions Conversion[]
  clickEvents Click[]
  createdAt   DateTime     @default(now())
}

model Conversion {
  id             String       @id @default(cuid())
  publisherId    String
  publisher      Publisher    @relation(fields: [publisherId], references: [id])
  trackingLinkId String
  trackingLink   TrackingLink @relation(fields: [trackingLinkId], references: [id])
  // Click.id the visitor arrived with; null when the callback did not echo it back.
  clickId        String?
  // PaisaWin registration reference. Globally unique: one registration counts once.
  externalUserId String       @unique
  amount         Decimal      @default(0.05) @db.Decimal(12, 4)
  status         String       @default("CONFIRMED")
  isValid        Boolean      @default(true)
  settlementId   String?
  settledAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([publisherId, createdAt])
  @@index([trackingLinkId, createdAt])
  @@index([createdAt])
  @@index([settlementId])
}

// Audit trail of every conversion callback received — credited, duplicate or
// rejected. Rejected rows are the admin review queue for unattributed events.
// No foreign keys on purpose: audit rows must outlive the records they mention.
model ConversionEvent {
  id             String   @id @default(cuid())
  source         String // GET | POST
  outcome        String // CREDITED | DUPLICATE | REJECTED
  reason         String
  code           String?
  externalUserId String?
  clickId        String?
  linkType       String?
  secretMatched  Boolean  @default(false)
  secretHint     String   @default("")
  conversionId   String?
  publisherId    String?
  trackingLinkId String?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([outcome, createdAt])
}

model PubWithdrawal {
  id                 String    @id @default(cuid())
  publisherId        String
  publisher          Publisher @relation(fields: [publisherId], references: [id])
  amount             Decimal   @db.Decimal(12, 4)
  walletAddress      String
  network            String    @default("TRC20")
  // PENDING -> APPROVED -> PROCESSING -> PAID | REJECTED | UNCERTAIN
  status             String    @default("PENDING")
  note               String?
  txReference        String?
  payoutBatchDate    String?
  failureReason      String?
  idempotencyKey     String?   @unique
  approvedAt         DateTime?
  approvedByAdminId  String?
  processedByAdminId String?
  requestedAt        DateTime  @default(now())
  processedAt        DateTime?

  @@index([publisherId, requestedAt])
  @@index([status, payoutBatchDate])
}

model TrafficUser {
  id              String              @id @default(cuid())
  email           String              @unique
  passwordHash    String
  name            String
  phone           String?
  walletBalance   Decimal             @default(0) @db.Decimal(12, 4)
  reservedBalance Decimal             @default(0) @db.Decimal(12, 4)
  isActive        Boolean             @default(true)
  trafficLinks    TrafficLink[]
  earnings        TrafficEarning[]
  withdrawals     TrafficWithdrawal[]
  createdAt       DateTime            @default(now())
}

model TrafficLink {
  id           String           @id @default(cuid())
  userId       String
  user         TrafficUser      @relation(fields: [userId], references: [id])
  uniqueCode   String           @unique
  targetUrl    String
  totalClicks  Int              @default(0)
  uniqueClicks Int              @default(0)
  conversions  Int              @default(0)
  isActive     Boolean          @default(true)
  clicks       TrafficClick[]
  earnings     TrafficEarning[]
  createdAt    DateTime         @default(now())
}

model TrafficClick {
  id            String      @id @default(cuid())
  trafficLinkId String
  trafficLink   TrafficLink @relation(fields: [trafficLinkId], references: [id])
  ip            String
  userAgent     String
  country       String?
  device        String?
  isUnique      Boolean     @default(true)
  timestamp     DateTime    @default(now())

  @@index([trafficLinkId, timestamp])
  @@index([timestamp])
}

model TrafficEarning {
  id             String      @id @default(cuid())
  userId         String
  user           TrafficUser @relation(fields: [userId], references: [id])
  trafficLinkId  String
  trafficLink    TrafficLink @relation(fields: [trafficLinkId], references: [id])
  externalUserId String
  amount         Decimal     @default(3.00) @db.Decimal(12, 4)
  isValid        Boolean     @default(true)
  settlementId   String?
  settledAt      DateTime?
  createdAt      DateTime    @default(now())

  @@unique([trafficLinkId, externalUserId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([settlementId])
}

model TrafficWithdrawal {
  id                 String      @id @default(cuid())
  userId             String
  user               TrafficUser @relation(fields: [userId], references: [id])
  amount             Decimal     @db.Decimal(12, 4)
  walletAddress      String
  network            String      @default("TRC20")
  // PENDING -> APPROVED -> PROCESSING -> PAID | REJECTED | UNCERTAIN
  status             String      @default("PENDING")
  note               String?
  txReference        String?
  payoutBatchDate    String?
  failureReason      String?
  idempotencyKey     String?     @unique
  approvedAt         DateTime?
  approvedByAdminId  String?
  processedByAdminId String?
  requestedAt        DateTime    @default(now())
  processedAt        DateTime?

  @@index([userId, requestedAt])
  @@index([status, payoutBatchDate])
}

model GlobalConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Click {
  id             String       @id @default(cuid())
  trackingLinkId String
  trackingLink   TrackingLink @relation(fields: [trackingLinkId], references: [id])
  publisherId    String
  publisher      Publisher    @relation(fields: [publisherId], references: [id])
  ip             String
  userAgent      String
  referrer       String       @default("")
  isValid        Boolean      @default(true)
  timestamp      DateTime     @default(now())

  @@index([publisherId, timestamp])
  @@index([timestamp])
}

// Authoritative next-day settlement per account and IST calendar date.
// Unique constraint guarantees repeat runs or concurrent workers cannot double-credit.
model DailySettlement {
  id               String   @id @default(cuid())
  accountType      String // PUBLISHER | TRAFFIC
  accountId        String
  settlementDate   String // IST YYYY-MM-DD of traffic/earnings
  scheduledPayDate String // IST YYYY-MM-DD next calendar day
  grossAmount      Decimal  @db.Decimal(12, 4)
  conversionCount  Int      @default(0)
  status           String   @default("SETTLED") // SETTLED | LEGACY_SETTLED | PENDING_VALIDATION | EXCEPTION
  note             String?
  batchRunId       String?
  settledAt        DateTime @default(now())

  @@unique([accountType, accountId, settlementDate])
  @@index([settlementDate, status])
  @@index([scheduledPayDate])
}

// Tracks daily next-day settlement and 12:00-14:00 IST payout batch runs.
model SettlementBatchRun {
  id             String    @id @default(cuid())
  batchDate      String // IST YYYY-MM-DD
  trafficDate    String // IST YYYY-MM-DD being settled
  kind           String // SETTLEMENT | PAYOUT_BATCH
  status         String // STARTED | COMPLETED | COMPLETED_WITH_EXCEPTIONS | FAILED
  eligibleCount  Int       @default(0)
  totalAmount    Decimal   @default(0) @db.Decimal(12, 4)
  paidCount      Int       @default(0)
  exceptionCount Int       @default(0)
  triggeredBy    String    @default("ADMIN") // ADMIN | CRON | LOCAL_TRIAL
  actorAdminId   String?
  notes          String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([batchDate, kind])
}

// Durable append-only financial ledger. Never cleared by report archival.
model LedgerTransaction {
  id            String   @id @default(cuid())
  accountType   String // PUBLISHER | TRAFFIC
  accountId     String
  entryType     String // EARNING_ACCRUED | SETTLEMENT_CREDIT | WITHDRAWAL_RESERVE | WITHDRAWAL_PAID | WITHDRAWAL_RELEASE | ADJUSTMENT
  direction     String // MEMO | CREDIT | RESERVE | DEBIT | RELEASE
  amount        Decimal  @db.Decimal(12, 4)
  balanceAfter  Decimal  @db.Decimal(12, 4)
  reservedAfter Decimal  @db.Decimal(12, 4)
  referenceType String // CONVERSION | TRAFFIC_EARNING | DAILY_SETTLEMENT | PUB_WITHDRAWAL | TRAFFIC_WITHDRAWAL | BACKFILL
  referenceId   String
  idempotencyKey String  @unique
  actorAdminId  String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([accountType, accountId, createdAt])
  @@index([referenceType, referenceId])
}

// Immutable status transition history for every withdrawal request.
model WithdrawalStatusHistory {
  id             String   @id @default(cuid())
  withdrawalType String // PUBLISHER | TRAFFIC
  withdrawalId   String
  fromStatus     String?
  toStatus       String
  actorType      String // PUBLISHER | TRAFFIC | ADMIN | SYSTEM
  actorId        String?
  txReference    String?
  note           String?
  createdAt      DateTime @default(now())

  @@index([withdrawalType, withdrawalId, createdAt])
}

// Restricted-access verified backup created before hiding/clearing historical report dates.
model TrafficReportBackup {
  id               String                     @id @default(cuid())
  reportDates      Json
  portalScope      String                     @default("ALL")
  checksumSha256   String
  payloadJson      String
  recordCount      Int
  verifiedAt       DateTime
  createdByAdminId String
  createdAt        DateTime                   @default(now())
  clearedDates     ClearedTrafficReportDate[]
}

// Tracks historical IST dates logically cleared from the active traffic report view.
// Authoritative Click, Conversion, Settlement and Ledger records remain untouched.
model ClearedTrafficReportDate {
  id                  String              @id @default(cuid())
  reportDate          String              @unique // IST YYYY-MM-DD
  status              String              @default("CLEARED") // CLEARED | RESTORED
  backupId            String
  backup              TrafficReportBackup @relation(fields: [backupId], references: [id])
  clearedByAdminId    String
  clearedAt           DateTime            @default(now())
  reason              String
  snapshotTotalClicks Int                 @default(0)
  snapshotValidClicks Int                 @default(0)
  snapshotEarnings    Decimal             @default(0) @db.Decimal(12, 4)
  restoredByAdminId   String?
  restoredAt          DateTime?
  restoreReason       String?
  updatedAt           DateTime            @updatedAt
}

// Durable audit log for report clearing/restoring, settlements, payouts, and admin actions.
model AdminAuditLog {
  id            String   @id @default(cuid())
  actorAdminId  String
  actorEmail    String?
  action        String
  targetType    String
  targetId      String?
  dates         Json?
  affectedCount Int      @default(0)
  reason        String?
  outcome       String   @default("SUCCESS") // SUCCESS | BLOCKED | FAILED
  backupId      String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([action, createdAt])
  @@index([createdAt])
}
